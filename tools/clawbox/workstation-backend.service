[Unit]
Description=WORKSTATION FastAPI backend
Documentation=https://github.com/mshears713/workstation-backend
After=network-online.target
Wants=network-online.target
# The device polls this backend constantly; a restart loop that gives up
# would look like a dead workstation. Keep trying.
#
# This MUST live in [Unit]. It was in [Service], where systemd has ignored it
# since v230 -- silently, with no warning in the journal. `systemctl show`
# reported the defaults instead (StartLimitIntervalUSec=10s, Burst=5), so the
# unit did exactly what the comment says it must not: five restarts inside ten
# seconds and it gives up for good.
StartLimitIntervalSec=0

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/home/agent/.openclaw/workspace/workstation-backend
ExecStart=/home/agent/.openclaw/workspace/workstation-backend/.venv/bin/python -m uvicorn app.api.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

[Unit]
Description=WORKSTATION FastAPI backend
Documentation=https://github.com/mshears713/workstation-backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/home/agent/.openclaw/workspace/workstation-backend
ExecStart=/home/agent/.openclaw/workspace/workstation-backend/.venv/bin/python -m uvicorn app.api.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3
# The device polls this backend constantly; a restart loop that gives up
# would look like a dead workstation. Keep trying.
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target

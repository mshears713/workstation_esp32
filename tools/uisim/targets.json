{
  "about": "Render targets for the workstation-ui simulator (/opt/workstation/lvgl-sim). Each target compiles REAL firmware UI sources from main/ plus a small adapter in tools/uisim/targets/ that turns fixture state into the same calls status_deck_ui.c makes. Fixture values are flat strings/ints/bools; 'fixtures' are named, realistic states. See tools/uisim/README.md.",
  "targets": {
    "voice_listening_widget": {
      "kind": "component",
      "description": "HOME's microphone: rotating outer ring with a travelling highlight, counter-rotating accent, inner ring, halo, navy disc, white mic. 172x172. Its colour/motion is the device's link indicator. Rendered alone, centred on a plain screen.",
      "sources": [
        "main/voice_listening_widget.c"
      ],
      "headers": [
        "voice_listening_widget.h"
      ],
      "adapter": "tools/uisim/targets/voice_listening_widget.c",
      "fields": {
        "link": {
          "type": "enum",
          "values": [
            "ok",
            "down",
            "no_net",
            "unknown"
          ],
          "default": "ok",
          "doc": "backend reachability as the widget shows it: ok = spinning + white mic; down = stopped + red mic; no_net = stopped + grey mic; unknown = spinning + grey mic"
        },
        "notification_pending": {
          "type": "bool",
          "default": false,
          "doc": "outer ring turns orange while a low-confidence notification waits"
        }
      },
      "fixtures": {
        "default": {},
        "backend_down": {
          "link": "down"
        },
        "no_wifi": {
          "link": "no_net"
        },
        "booting": {
          "link": "unknown"
        },
        "notification": {
          "notification_pending": true
        }
      }
    },
    "menu": {
      "kind": "page",
      "description": "EXPLORE (ui_menu_build_pictures): Tour / Newton / Lincoln picture cards with TOOLS > in the title band and < HOME; page=tools: SENSORS, LOG, FIRMWARE, SETTINGS, DIAG with < MENU.",
      "sources": [
        "main/ui_kit.c",
        "main/ui_menu.c",
        "main/ui_adventure.c",
        "main/ui_story_dialogue.c",
        "main/voice_listening_widget.c",
        "main/newton_art.c",
        "main/lincoln_art.c"
      ],
      "headers": [
        "lincoln_art.h",
        "newton_art.h",
        "ui_adventure.h",
        "ui_kit.h",
        "ui_lincoln.h",
        "ui_menu.h",
        "ui_newton.h",
        "ui_theme.h"
      ],
      "adapter": "tools/uisim/targets/menu.c",
      "fields": {
        "page": {
          "type": "enum",
          "values": [
            "explore",
            "tools"
          ],
          "default": "explore",
          "doc": "EXPLORE cards or the TOOLS page"
        }
      },
      "fixtures": {
        "default": {},
        "tools": {
          "page": "tools"
        }
      }
    },
    "firmware": {
      "kind": "page",
      "description": "FIRMWARE as a timeline (ui_firmware_page.c + ui_fw_timeline.c): running version and slot (CONFIRMED / ON PROBATION); CHECK - GET - VERIFY - BOOT - HEALTH - KEPT from ota_service's state, a FAILED placed on its stage by ota_service's own message (unknown messages point at no stage); download percent is the updater's measured one; the health gate shows its 90 s limit, not an invented countdown; backend address (FB = fallback) and build time; CHECK NOW asks CLAWBOX again, never forces an install.",
      "sources": [
        "main/ui_kit.c",
        "main/ui_fw_timeline.c",
        "main/ui_firmware_page.c"
      ],
      "headers": [

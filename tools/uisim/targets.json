    "menu": {
      "kind": "page",
      "description": "MENU (ui_menu.c, 1.3.0): six 151x54 buttons, two to a row, to SENSORS, LOG, PROJECTS, FIRMWARE, SETTINGS, DIAG (the DIAGNOSTICS page), the < HOME back button on top.",
      "sources": [
        "main/ui_kit.c",
        "main/ui_menu.c"
      ],
      "headers": [
        "ui_kit.h",
        "ui_menu.h",
        "ui_theme.h"
      ],
      "adapter": "tools/uisim/targets/menu.c",
      "fields": {},
      "fixtures": {
        "default": {}
      }
    },
    "firmware": {
      "kind": "page",
      "description": "FIRMWARE page (ui_firmware_page.c): version, build time, backend address, OTA slot and probation state, updater status line, CHECK CLAWBOX NOW button; the < HOME back button.",
      "sources": [
        "main/ui_kit.c",
        "main/ui_firmware_page.c"
      ],
      "headers": [
        "ui_firmware_page.h",
        "ui_kit.h",
        "ui_theme.h"
      ],
      "adapter": "tools/uisim/targets/firmware.c",
      "fields": {
        "version": {
          "type": "str",
          "default": "1.2.2+2d189af",
          "doc": "firmware_version(): <semver>+<sha>[-dirty]"
        },
        "built_at": {
          "type": "str",
          "default": "Sep 23 2026 15:06:22",
          "doc": "firmware_built_at(): __DATE__ __TIME__ of the build"
        },
        "backend_url": {
          "type": "str",
          "default": "http://192.168.1.71:8000",
          "doc": "device_config_backend_base_url()"
        },
        "backend_fallback": {
          "type": "bool",
          "default": false,
          "doc": "running on the fallback address (clawbox.local)"
        },
        "slot": {
          "type": "str",
          "default": "ota_1",
          "doc": "running partition label: ota_0 / ota_1"
        },
        "pending_verify": {
          "type": "bool",
          "default": false,
          "doc": "image still on probation (health gate not passed)"
        },
        "ota_state": {
          "type": "enum",
          "values": [
            "idle",
            "validating",
            "checking",
            "update ready",
            "downloading",
            "verifying",
            "rebooting",
            "failed"
          ],
          "default": "idle",
          "doc": "ota_service_state_label()"
        },
        "ota_message": {
          "type": "str",
          "default": "up to date (1.2.2+2d189af)",
          "doc": "ota_status_t.message (<= 79 chars)"
        },
        "ota_progress_pct": {
          "type": "int",
          "default": 0,
          "doc": "0-100, shown while ota_state is downloading"
        }
      },
      "fixtures": {
        "default": {},
        "probation": {
          "pending_verify": true,
          "ota_state": "validating",
          "ota_message": "new image on probation, validating"
        },
        "downloading": {
          "ota_state": "downloading",
          "ota_progress_pct": 42,
          "ota_message": "1.2.3+9f3c1aa -> ota_0"
        },
        "failed": {
          "ota_state": "failed",
          "ota_message": "hash mismatch, not installing"
        },
        "fallback_backend": {
          "backend_url": "http://clawbox.local:8000",
          "backend_fallback": true,
          "ota_message": "no manifest from CLAWBOX"
        }
      }
    },
    "diagnostics": {
      "kind": "page",
      "description": "DIAGNOSTICS (ui_diagnostics.c + ui_diag_format.c): four square blocks - LINK (Wi-Fi state + RSSI, backend reachability), SENSORS (ICM42670 accel and AHT30 temp/RH freshness), UPTIME (days / h m), INTERNAL HEAP KiB (free, largest block, min since boot). The global < HOME button on top. ALL telemetry values in these fixtures are ILLUSTRATIVE except heap_constrained, which uses the 1.2.0 report's real min/largest.",
      "sources": [
        "main/ui_kit.c",
        "main/ui_diag_format.c",
        "main/ui_diagnostics.c"
      ],
      "headers": [
        "ui_kit.h",
        "ui_diag_format.h",
        "ui_diagnostics.h",
        "ui_theme.h"
      ],
      "adapter": "tools/uisim/targets/diagnostics.c",
      "fields": {
        "wifi": {
          "type": "enum",
          "values": [
            "off",
            "joining",
            "online",
            "retry"
          ],
          "default": "online",
          "doc": "wifi_mgr_state_t: DISCONNECTED / CONNECTING / ONLINE / RETRY_WAIT"
        },
        "have_rssi": {
          "type": "bool",
          "default": true,
          "doc": "esp_wifi_sta_get_ap_info() answered (only tried while ONLINE)"
        },
        "rssi_dbm": {
          "type": "int",
          "default": -61,
          "doc": "wifi_ap_record_t.rssi"
        },
        "wifi_reason": {
          "type": "str",
          "default": "",
          "doc": "wifi_mgr reason_text (<= 19 chars): NO AP FOUND / AUTH FAILED / WIFI LOST / RETRYING"
        },
        "wifi_attempts": {
          "type": "int",
          "default": 1,
          "doc": "attempt_count"
        },
        "wifi_retry_s": {
          "type": "int",
          "default": 0,
          "doc": "retry_remaining_s"
        },
        "api": {
          "type": "enum",
          "values": [
            "unknown",
            "ok",
            "down",
            "no_net"
          ],
          "default": "ok",
          "doc": "backend_health_state_t"
        },
        "api_ever_ok": {
          "type": "bool",
          "default": true,
          "doc": "backend_health_stats_t.ever_ok"
        },
        "api_secs_since_ok": {
          "type": "int",
          "default": 0,
          "doc": "backend_health_stats_t.secs_since_ok"
        },
        "accel": {
          "type": "enum",
          "values": [
            "unknown",
            "failed",
            "waiting",
            "live",
            "stale"
          ],
          "default": "live",
          "doc": "ui_diag_freshness(): probe not run / init failed / no sample yet / within 300 ms / older"
        },
        "accel_age_ms": {
          "type": "int",
          "default": 100,
          "doc": "now - sensor_last_good_us"
        },
        "env": {
          "type": "enum",
          "values": [
            "unknown",
            "failed",
            "waiting",
            "live",
            "stale"
          ],
          "default": "live",
          "doc": "same, AHT30 (temp + RH share one timestamp), stale after 3 s"
        },
        "env_age_ms": {
          "type": "int",
          "default": 800,
          "doc": "now - humiture_last_good_us"
        },
        "uptime_s": {
          "type": "str",
          "default": "371553",
          "doc": "seconds since boot as a decimal string (uint32 range)"
        },
        "heap_free": {
          "type": "int",
          "default": 42190,
          "doc": "heap_caps_get_free_size(MALLOC_CAP_INTERNAL), bytes"
        },
        "heap_largest": {
          "type": "int",
          "default": 18432,
          "doc": "heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL)"
        },
        "heap_min": {
          "type": "int",
          "default": 9830,
          "doc": "heap_caps_get_minimum_free_size(MALLOC_CAP_INTERNAL)"
        }
      },

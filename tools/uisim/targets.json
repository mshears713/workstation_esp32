    "survey": {
      "kind": "page",
      "description": "EXPERIMENT: event-feedback survey kiosk (ui_survey.c, Calm Paper): welcome, three SAMPLE question screens (1-5 tiles, 0-10 slider with -/+ keys, three-way choice), review/submit, thank-you with a QR to a SAMPLE link (example.com), next-visitor reset. Full-screen sheet; no HOME button; organiser leaves by holding the top bar 3 s on welcome. Questions and link are placeholders.",
      "sources": [
        "main/ui_paper.c",
        "main/ui_survey.c"
      ],
      "headers": [
        "ui_paper.h",
        "ui_survey.h",
        "ui_theme.h"
      ],
      "adapter": "tools/uisim/targets/survey.c",
      "fields": {
        "step": {
          "type": "enum",
          "values": [
            "welcome",
            "q1",
            "q2",
            "q3",
            "review",
            "thanks"
          ],
          "default": "welcome",
          "doc": "screen to open on (ui_survey_preview); taps then drive the real flow"
        },
        "a1": {
          "type": "int",
